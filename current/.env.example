# MOEX Trading Robot v3.6.0 — пример локальной конфигурации.
# Скопируйте в .env и не публикуйте этот файл.

# Отдельный токен T-Invest Sandbox.
TBANK_SANDBOX_TOKEN=
TBANK_SANDBOX_ACCOUNT_ID=
SANDBOX_INITIAL_RUB=1000000

# Обычно поле пустое: используется системное хранилище сертификатов Windows.
# Для корпоративного proxy/антивируса можно указать доверенный PEM bundle.
TBANK_CA_BUNDLE=
TBANK_CONNECT_TIMEOUT_SECONDS=8
TBANK_READ_TIMEOUT_SECONDS=25

# Инструмент и цикл.
ROBOT_TICKER=SBER
ROBOT_CLASS_CODE=TQBR
ROBOT_CANDLE_INTERVAL=CANDLE_INTERVAL_HOUR
ROBOT_LOOKBACK_DAYS=30
ROBOT_POLL_SECONDS=300
ROBOT_MAX_ORDER_LOTS=1
ROBOT_ORDER_TYPE=BESTPRICE
ROBOT_TIME_IN_FORCE=FILL_AND_KILL
ROBOT_STATE_FILE=robot_state.json
ROBOT_JOURNAL_FILE=trading_events.db
ROBOT_STRATEGY_PROFILE_FILE=strategy_profiles.json

# v3.6.0: одна PRIMARY-стратегия может отправлять Sandbox-заявки.
# SHADOW-стратегии рассчитываются на тех же новых свечах и только журналируются.
# Допустимые значения: sma, donchian, ensemble.
ROBOT_PRIMARY_STRATEGY=sma
ROBOT_SHADOW_STRATEGIES=donchian,ensemble

# SMA с гистерезисом.
ROBOT_FAST_WINDOW=20
ROBOT_SLOW_WINDOW=50
# Значение в процентах: 0.2 = 0,2%.
ROBOT_SMA_HYSTERESIS_PERCENT=0.2

# Donchian breakout + ATR trailing exit.
ROBOT_DONCHIAN_ENTRY_WINDOW=55
ROBOT_DONCHIAN_EXIT_WINDOW=20
ROBOT_DONCHIAN_ATR_WINDOW=20
ROBOT_DONCHIAN_TRAILING_STOP_ATR=3.0

# Ансамбль трендов.
ROBOT_ENSEMBLE_SMA_FAST=50
ROBOT_ENSEMBLE_SMA_SLOW=200
ROBOT_ENSEMBLE_MOMENTUM_WINDOW=126
ROBOT_ENSEMBLE_BREAKOUT_WINDOW=100
ROBOT_ENSEMBLE_VOTE_THRESHOLD=3

# Общий слой размера позиции.
# Пусто/0/OFF = отключить volatility targeting.
# Значение в процентах: 15 = 15% годовой целевой волатильности.
ROBOT_TARGET_VOLATILITY_PERCENT=
ROBOT_VOLATILITY_WINDOW=20
# Верхний предел доли ROBOT_MAX_ORDER_LOTS, в процентах.
ROBOT_MAX_STRATEGY_WEIGHT_PERCENT=100

# Устойчивость и восстановление.
ROBOT_FAILURE_THRESHOLD=3
ROBOT_CIRCUIT_OPEN_SECONDS=60
ROBOT_CIRCUIT_MAX_OPEN_SECONDS=900
# 0 = безопасный автоматический предел по таймфрейму.
ROBOT_MAX_SIGNAL_AGE_SECONDS=0
ROBOT_RECONCILE_ATTEMPTS=3
ROBOT_RECONCILE_DELAY_SECONDS=0.5
# Даже без новой свечи Sandbox-исполнитель повторно сверяет брокерскую позицию.
ROBOT_PORTFOLIO_RECONCILE_INTERVAL_SECONDS=900

# v3.6.0: market-aware idle mode.
# Когда T-Invest явно сообщает, что выбранный тип заявки недоступен,
# свечи и стратегии временно не пересчитываются. Pending-order recovery
# всегда выполняется раньше MARKET_IDLE.
ROBOT_MARKET_IDLE_ENABLED=YES
# Как часто проверять торговый статус во время активного рынка.
ROBOT_MARKET_STATUS_CHECK_SECONDS=300
# Интервал повторной проверки во время MARKET_IDLE.
ROBOT_MARKET_IDLE_POLL_SECONDS=300
# Редкая сверка портфеля, пока рынок закрыт.
ROBOT_MARKET_IDLE_RECONCILE_SECONDS=1800
# Компактный MARKET_IDLE heartbeat в журнале.
ROBOT_MARKET_IDLE_HEARTBEAT_SECONDS=1800

LOG_LEVEL=INFO

# Второй предохранитель. Оставьте NO для dry-run.
# Для виртуального исполнения нужны одновременно YES и ключ --execute.
ARM_SANDBOX_TRADING=NO

# v3.6.0: GUI и CLI читают PRIMARY/SHADOW из отдельных checksummed-профилей
# DRY_RUN и SANDBOX_EXECUTION в strategy_profiles.json. Параметры ROBOT_* выше
# используются только при одноразовой миграции первого DRY_RUN. CLI execution
# никогда не возвращается к ним молча, если Sandbox-профиль отсутствует.
# Risk Engine использует отдельный risk_profiles.json. Для SANDBOX_EXECUTION
# профиль должен быть заранее сохранён; отсутствие/повреждение блокирует новый intent.

# Протоколирование и диагностика производительности.
# Компактный heartbeat для уже обработанной свечи не чаще указанного интервала.
# 0 = писать каждый heartbeat на INFO; рекомендуемое значение 1800 секунд.
ROBOT_HEARTBEAT_LOG_SECONDS=1800
# Цикл дольше этого порога создаёт событие performance/SLOW_CYCLE.
ROBOT_SLOW_CYCLE_SECONDS=10

# Risk Dashboard и burn-in reports создаются локально в risk_beta_output/.
# Каталог не включается в релизные ZIP.
